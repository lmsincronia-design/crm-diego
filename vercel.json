{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*\\.(html|css|js|ico|png|jpg|svg))", "dest": "/public/$1", "headers": { "Cache-Control": "no-store" } },
    { "src": "/", "dest": "/public/index.html", "headers": { "Cache-Control": "no-store" } },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
