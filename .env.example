# Base de datos PostgreSQL (Vercel Postgres, Supabase, o Neon - todos gratis)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Apollo.io - crea cuenta gratis en apollo.io, ve a Settings > API Keys
APOLLO_API_KEY=

